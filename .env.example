# PostgreSQL (на сервере Reg.ru создается автоматически скриптом deploy/install-regru.sh)
DATABASE_URL=postgresql://tipster_user:strong_postgres_password@127.0.0.1:5432/tipster_db

# Секретный ключ подписи сессий пользователей (генерируется автоматически при установке)
SESSION_SECRET=change_this_to_a_long_random_64_char_secret_string

# Стартовый вход администратора (после первого запуска можно сменить в /admin -> Настройки)
ADMIN_EMAIL=admin@valuex.pro
ADMIN_PASSWORD=Admin2026!

# Платный российский ИИ-шлюз PlusVibeAPI (https://plusvibeapi.ru/v1 · без VPN, оплата рублями, ключ sk-pv-...)
PLUSVIBE_API_KEY=
PLUSVIBE_BASE_URL=https://plusvibeapi.ru/v1
PLUSVIBE_MODEL=deepseek-v4.1-flash-1017

# Резервный ИИ-шлюз Ollama Cloud (https://ollama.com/v1 · модель deepseek-v4.1-flash)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4.1-flash

# Опционально: универсальный API-ключ нейросети (также удобно настраивается в /admin)
AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://plusvibeapi.ru/v1
AI_LLM_MODEL=deepseek-v4.1-flash-1017

# Ключи ЮKassa и Telegram-бота (также удобно задаются в браузере /admin -> Настройки)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
