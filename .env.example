# PostgreSQL 16
DATABASE_URL=postgresql://tipster_user:strong_postgres_password@localhost:5432/tipster_db

# Redis (BullMQ очереди для Telegram-пушей и автопродлений ЮKassa)
REDIS_URL=redis://localhost:6379

# JWT Авторизация
JWT_ACCESS_SECRET=replace_with_64_char_random_secret
JWT_REFRESH_SECRET=replace_with_64_char_random_refresh_secret

# Интеграция ЮKassa API v3 + Чеки 54-ФЗ
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_replace_with_yookassa_secret_key
YOOKASSA_VAT_CODE=1
PUBLIC_RETURN_URL=https://valuex.pro/payment/success

# Интеграция Telegram Bot API и закрытого VIP-канала
TELEGRAM_BOT_TOKEN=1234567890:AAF_replace_with_botfather_token
TELEGRAM_VIP_CHANNEL_ID=-1002145987654
