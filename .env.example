# Локальная разработка может работать на local_file без DATABASE_URL (один процесс).
# Если DATABASE_URL задан и PostgreSQL недоступна, перехода на локальный файл нет.
# Установщик Reg.ru заполнит пароль БД и сформирует URL с уникальными значениями.
DATABASE_URL=
POSTGRES_USER=tipster_user
POSTGRES_PASSWORD=
POSTGRES_DB=tipster_db
# Канонический HTTPS-адрес без пути; обязателен для реальных платежей и Telegram в production.
# После изменения NEXT_PUBLIC_SITE_URL пересоберите приложение.
NEXT_PUBLIC_SITE_URL=

# Обязательные production-секреты. Не коммитьте реальные значения.
# SESSION_SECRET и AUTOPILOT_CRON_SECRET: не менее 32 случайных символов.
SESSION_SECRET=
AUTOPILOT_CRON_SECRET=

# Стартовая учётная запись администратора. Для production пароль не менее 12 символов.
# Установщик создаст уникальный пароль, если поля не заполнены.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Пример конфигурации PlusVibeAPI: уточняйте адрес, модель, стоимость и доступность у провайдера.
PLUSVIBE_API_KEY=
PLUSVIBE_BASE_URL=https://plusvibeapi.ru/v1
PLUSVIBE_MODEL=deepseek-v4.1-flash

# Резервный ИИ-шлюз Ollama Cloud (https://ollama.com/v1 · модель deepseek-v4.1-flash)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4.1-flash

# Опционально: универсальный ключ. Для PlusVibe предпочтительно PLUSVIBE_API_KEY выше.
# Для обычного AI_LLM_API_KEY пустые адрес и модель означают DeepSeek API и deepseek-chat.
# Явно указанные AI_LLM_BASE_URL и AI_LLM_MODEL используются как есть; проверьте их у провайдера.
AI_LLM_API_KEY=
AI_LLM_BASE_URL=
AI_LLM_MODEL=

# Ключи ЮKassa и Telegram-бота (также удобно задаются в браузере /admin -> Настройки)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
