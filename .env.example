# Локальная разработка может работать на local_file без DATABASE_URL (один процесс).
# Если DATABASE_URL задан и PostgreSQL недоступна, перехода на локальный файл нет.
# Установщик Reg.ru заполнит пароль БД и сформирует URL с уникальными значениями.
DATABASE_URL=
POSTGRES_USER=tipster_user
POSTGRES_PASSWORD=
POSTGRES_DB=tipster_db
NEXT_PUBLIC_SITE_URL=

# Обязательные production-секреты. Не коммитьте реальные значения.
# SESSION_SECRET и AUTOPILOT_CRON_SECRET: не менее 32 случайных символов.
SESSION_SECRET=
AUTOPILOT_CRON_SECRET=

# Стартовая учётная запись администратора. Для production пароль не менее 12 символов.
# Установщик создаст уникальный пароль, если поля не заполнены.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Платный российский ИИ-шлюз PlusVibeAPI (https://plusvibeapi.ru/v1 · без VPN, оплата рублями, ключ sk-pv-...)
PLUSVIBE_API_KEY=
PLUSVIBE_BASE_URL=https://plusvibeapi.ru/v1
PLUSVIBE_MODEL=deepseek-v4.1-flash-1017

# Резервный ИИ-шлюз Ollama Cloud (https://ollama.com/v1 · модель deepseek-v4.1-flash)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4.1-flash

# Опционально: универсальный API-ключ нейросети (также удобно настраивается в /admin)
AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://plusvibeapi.ru/v1
AI_LLM_MODEL=deepseek-v4.1-flash-1017

# Ключи ЮKassa и Telegram-бота (также удобно задаются в браузере /admin -> Настройки)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
